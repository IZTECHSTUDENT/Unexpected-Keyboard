<?xml version="1.0" encoding="utf-8"?>
<keyboard name="QWERTY (Türkçe Tablet)" script="latin"
    bottom_row="false" embedded_number_row="true" locale_extra_keys="false"
    skip_auto_split="true">
  <modmap>
    <shift a="i" b="İ" />
    <shift a="ı" b="I" />
  </modmap>

  <row scale="17">
    <key key0="+" key1="-" key2="=" key3="×" key4="÷"/>
    <key key0="1" key4="loc esc"/>
    <key key0="2"/>
    <key key0="3"/>
    <key key0="4"/>
    <key key0="5"/>
    <key shift="5" key0="6"/>
    <key key0="7"/>
    <key key0="8"/>
    <key key0="9"/>
    <key key0="0"/>
    <key role="action" key0="switch_clipboard"/>
  </row>

  <row scale="17">
    <key key0="q" key2="%"/>
    <key key0="w" key2="\\"/>
    <key key0="e" key2="~"/>
    <key key0="r" key2="|"/>
    <key key0="t" key2="["/>
    <key key0="y" key2="]"/>
    <key shift="5" key0="u" key2="&lt;"/>
    <key key0="ı" key2="&gt;"/>
    <key key0="o" key2="{"/>
    <key key0="p" key2="}"/>
    <key key0="ğ" key2="©"/>
    <key key0="ü" key2="™"/>
  </row>

  <row scale="17">
    <key key0="a" key1="loc tab" key2="\@"/>
    <key key0="s" key2="\#"/>
    <key key0="d" key2="&amp;"/>
    <key key0="f" key2="*"/>
    <key key0="g" key2="+"/>
    <key key0="h" key2="="/>
    <key width="1.2" shift="5" key0="j" key2="-"/>
    <key width="1.2" key0="k" key2="("/>
    <key width="1.2" key0="l" key2=")"/>
    <key width="1.2" key0="ş" key2="*"/>
    <key width="1.2" key0="i" key2="÷"/>
  </row>

  <row scale="17">
    <key width="1" role="action" key0="shift" key2="loc capslock"/>
    <key key0="z" key2="_"/>
    <key key0="x" key2="₺"/>
    <key key0="c" key2="&quot;"/>
    <key key0="v" key2="'"/>
    <key key0="b" key2="/"/>
    <key width="1.125" shift="5" key0="n" key2="_"/>
    <key width="1.125" key0="m" key2=";"/>
    <key width="1.125" key0="ö" key2="^"/>
    <key width="1.125" key0="ç" key2="$"/>
    <key width="1.5" role="action" key0="backspace" key2="delete"/>
  </row>

  <row height="0.95" scale="17">
    <key width="1.7" role="action"
        key0="switch_numeric"
        key1="loc switch_greekmath"
        key2="loc meta"
        key3="loc switch_clipboard"
        key4="ctrl"/>

    <key width="1.1" role="action"
        key0="switch_emoji"
        key1="loc alt"
        key2="loc change_method"
        key3="fn"
        key4="config"/>

    <key width="3.2" role="space_bar"
        key0="space"
        key7="switch_forward"
        key8="switch_backward"
        key5="cursor_left"
        key6="cursor_right"/>

    <key width="3.2" shift="5" role="space_bar"
        key0="space"/>

    <key width="1"
        key0="."
        key1="!"
        key2="?"
        key3=","/>

    <key width="1.8" role="action"
        key0="enter"
        key1="loc voice_typing"
        key2="action"/>
  </row>
</keyboard>